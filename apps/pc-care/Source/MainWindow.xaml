</UniformGrid><WrapPanel Grid.Row="2" VerticalAlignment="Top"><Button x:Name="OpenFamilyCatalog" Content="Каталог и последние версии" Margin="0,0,10,0"/><Button x:Name="OpenFamilyCreator" Content="@creativerelab"/></WrapPanel></Grid>
        <Grid x:Name="PageHistory" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="История действий" Style="{StaticResource PageTitle}"/><TextBlock Text="Результаты очистки и изменения автозагрузки." Foreground="{DynamicResource Sub}"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,18,0,14"><StackPanel Orientation="Horizontal"><Button x:Name="HistoryRefreshButton" Content="Обновить"/><Button x:Name="HistoryRestoreButton" Content="Вернуть запись автозагрузки" IsEnabled="False"/></StackPanel><DockPanel Margin="0,12,0,0"><TextBlock x:Name="HistoryCount" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="HistorySearch" Tag="Поиск по действию, дате или подробностям"/></DockPanel></StackPanel>
          <DataGrid x:Name="HistoryGrid" Grid.Row="2" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Дата и время" Binding="{Binding Time}" SortMemberPath="TimeUtc" Width="165"/><DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="195"/><DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="*"/></DataGrid.Columns></DataGrid>
