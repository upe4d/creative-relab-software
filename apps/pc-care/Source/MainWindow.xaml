        <Grid x:Name="PageAbout" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><StackPanel Orientation="Horizontal"><Image x:Name="CreatorAvatar" Width="48" Height="48" Margin="0,0,14,0"/><TextBlock Text="Программы Creative Relab" Style="{StaticResource PageTitle}"/></StackPanel><TextBlock Text="Создатель: @creativerelab · переносимые приложения Windows" Foreground="{DynamicResource Sub}" Margin="0,8,0,20"/></StackPanel>
<UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">
<Border Background="{DynamicResource Panel}" CornerRadius="16" Padding="20" Margin="0,0,8,0"><StackPanel><TextBlock Text="PC Guard" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Проверка файлов, карантин, сейф и инструменты безопасности. Границы защиты указаны в программе." TextWrapping="Wrap" Margin="0,10,0,18"/><Button x:Name="OpenGuardFamily" Content="Подробнее о PC Guard"/></StackPanel></Border>
