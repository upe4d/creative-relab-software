<UserControl x:Class="optimizerDuck.UI.Controls.PartnerBanner"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions">
 <Border x:Name="BannerSurface" Margin="16,8,16,12" Padding="18,10" CornerRadius="16"
 Background="{DynamicResource PCTunePanelBrush}"
 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
 <Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Image Source="pack://application:,,,/Resources/Images/Zabivki.png" Width="190" Height="44" Stretch="Uniform" Margin="0,0,20,0"/>
 <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
 <TextBlock Text="{ext:Loc Partner.Label}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
 <TextBlock Text="{ext:Loc Partner.Description}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
 </StackPanel>
 <Button Grid.Column="2" Padding="18,10" MinWidth="116" VerticalAlignment="Center" Click="OpenPartner"
 Content="{ext:Loc Partner.Open}" ToolTip="https://zabivki.ru/"/>
 </Grid>
 </Border>
</UserControl>