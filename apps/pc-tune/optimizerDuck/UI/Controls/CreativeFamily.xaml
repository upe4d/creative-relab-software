<UserControl x:Class="optimizerDuck.UI.Controls.CreativeFamily" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ext="clr-namespace:optimizerDuck.Common.Extensions">
<StackPanel Margin="0,8,0,20">
<StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Resources/Images/PCTune.png" Width="48" Height="48" Margin="0,0,14,0"/><TextBlock Text="{ext:Loc Family.Company}" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/></StackPanel>
<TextBlock Text="{ext:Loc Family.Author}" Margin="0,4,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
<UniformGrid Columns="2">
<Border Background="{DynamicResource PCTunePanelBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,6,0"><StackPanel><TextBlock Text="PC Care" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><TextBlock Text="{ext:Loc Family.Care}" TextWrapping="Wrap" Margin="0,8,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Button Content="{ext:Loc Family.Details}" Tag="pc-care" Click="OpenProduct" Padding="16,8"/></StackPanel></Border>
<Border Background="{DynamicResource PCTunePanelBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="6,0,0,0"><StackPanel><TextBlock Text="PC Guard" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/><TextBlock Text="{ext:Loc Family.Guard}" TextWrapping="Wrap" Margin="0,8,0,14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Button Content="{ext:Loc Family.Details}" Tag="pc-guard" Click="OpenProduct" Padding="16,8"/></StackPanel></Border>
</UniformGrid><WrapPanel Margin="0,12,0,0"><Button x:Name="CheckProductUpdates" Content="{ext:Loc Updates.Check}" Click="OpenUpdates" Padding="16,8" Margin="0,0,8,0"/><Button Content="{ext:Loc Family.Catalog}" Tag="catalog" Click="OpenProduct" Padding="16,8" Margin="0,0,8,0"/><Button Content="@creativerelab" Tag="author" Click="OpenProduct" Padding="16,8"/></WrapPanel>
</StackPanel></UserControl>